# ── LLM provider: Cent AI (https://cent-ai.dev) ─────────────────────────────
# Which Cent AI API format to call:
#   messages  → Anthropic Messages API  (POST {LLM_BASE_URL}/messages, header x-api-key)  — best for Claude models
#   responses → OpenAI Responses API    (POST {LLM_BASE_URL}/responses, Bearer token)   — best for GPT-style models
LLM_API_FORMAT=messages

# Same for both formats: the AI SDK appends /messages or /responses itself.
# (The official Anthropic SDK would use https://api.cent-ai.dev without /v1; we don't use it.)
LLM_BASE_URL=https://api.cent-ai.dev/v1

# Your key from the Cent AI dashboard (looks like cai_...). Never commit it.
# Tip: give this key a daily spend limit and a model allowlist in the dashboard.
LLM_API_KEY=

# Exact model ID as returned by GET https://api.cent-ai.dev/v1/models (e.g. claude-opus-5, glm-5.3).
# Pick one whose "capabilities" include tools: the assistant needs tool calling.
LLM_MODEL=

# ── Agent server ───────────────────────────────────────────────────────────
PORT=4300
RESTAURANT_UTC_OFFSET=+07:00
# true ONLY when exactly one hosting proxy sits in front of this server. Otherwise clients can forge
# X-Forwarded-For and dodge the per-IP rate limits.
TRUST_PROXY=false

# ── Booking API (resortos-booking-api) ─────────────────────────────────────
BOOKING_API_URL=http://localhost:4000
# Service account the assistant signs in with (role AGENT; seeded by the API's db:seed). It may only book on a
# guest's behalf and look up one guest by email. A scoped API key will replace this later.
AGENT_EMAIL=assistant@resortos.internal
AGENT_PASSWORD=
# Signs booking drafts so the guest books exactly what was read back (any long random string).
AGENT_DRAFT_SECRET=
