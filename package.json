{
  "name": "resortos-booking-agent",
  "version": "1.0.0",
  "description": "ResortOS booking assistant (AI agent)",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file=.env scripts/centAiSmoke.ts",
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "e2e": "node --env-file=.env scripts/e2e.ts",
    "start:test": "PORT=4500 BOOKING_API_URL=http://localhost:4400 AGENT_API_KEY=e2e-only-agent-key-e2e-only-agent-key-0001 AGENT_DRAFT_SECRET=e2e-only-draft-secret-0001 CHAT_LIMIT_PER_MINUTE=1000 BOOKINGS_LIMIT_PER_HOUR=1000 SESSION_CHAT_LIMIT=1000 node --env-file=.env src/index.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.35",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/openai": "^4.0.108",
    "@mastra/core": "^1.81.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "zod": "^4.6.7"
  }
}
